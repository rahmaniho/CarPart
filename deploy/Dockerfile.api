# ساخت API کارپارت — چندمرحله‌ای
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/contract/package.json packages/contract/
COPY packages/api-client/package.json packages/api-client/
COPY apps/api/package.json apps/api/
RUN npm ci --no-audit --no-fund
COPY packages/ packages/
COPY apps/api/ apps/api/
RUN npm run build:contract \
  && npm run build -w @carpart/api-client \
  && npm run build -w @carpart/api

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/contract ./packages/contract
COPY --from=build /app/packages/api-client ./packages/api-client
COPY --from=build /app/apps/api ./apps/api
WORKDIR /app/apps/api
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://localhost:4000/health || exit 1
CMD ["node", "dist/main.js"]
