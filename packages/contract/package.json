{
  "name": "@carpart/contract",
  "version": "1.3.0",
  "private": true,
  "description": "قرارداد مشترک بین سرویس و رابط کاربری: نقش‌ها، مجوزها، وضعیت‌ها، ابزار پول و متن فارسی",
  "main": "dist/cjs/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json",
    "typecheck": "tsc -p tsconfig.cjs.json --noEmit && tsc -p tsconfig.esm.json --noEmit",
    "lint": "echo \"contract: no lint configured\""
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  }
}
