{
  "name": "@carpart/mobile",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "وب‌اپ و اپلیکیشن اندروید/PWA نقش‌محور کارپارت برای مکانیک، فروشنده، پیک و مدیریت",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
