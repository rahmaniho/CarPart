{
  "name": "@carpart/api",
  "version": "1.0.0",
  "private": true,
  "description": "سرویس پشتیان پلتفرم قطعه‌رسان (NestJS + TypeORM)",
  "main": "dist/main.js",
  "scripts": {
    "predev": "npm run build -w @carpart/contract",
    "dev": "npm run build && node dist/main.js",
    "build:contract": "npm run build -w @carpart/contract",
    "prebuild": "npm run build -w @carpart/contract",
    "build": "tsc -p tsconfig.build.json",
    "dev:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "pretest": "npm run build -w @carpart/contract",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:cov": "jest --coverage --runInBand",
    "predb:migrate": "npm run build",
    "db:migrate": "node dist/database/cli.js migrate",
    "predb:seed": "npm run build",
    "db:seed": "node dist/database/cli.js seed",
    "predb:reset": "npm run build",
    "db:reset": "node dist/database/cli.js reset",
    "predb:settings": "npm run build",
    "db:settings": "node dist/database/cli.js settings",
    "db:migration:generate": "node ../../node_modules/typeorm/cli.js migration:generate -d dist/database/cli-datasource.js"
  },
  "dependencies": {
    "@carpart/contract": "*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sql.js": "^1.13.0",
    "typeorm": "^0.3.31",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
